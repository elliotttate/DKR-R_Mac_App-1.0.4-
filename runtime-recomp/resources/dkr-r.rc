#include <windows.h>

#define IDI_DKRR 101

IDI_DKRR ICON "../../assets/ui/Icons/Diddy_Kong_Racing.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DKR_RELEASE_RESOURCE_VERSION
 PRODUCTVERSION DKR_RELEASE_RESOURCE_VERSION
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ThatGuyMcd\0"
            VALUE "FileDescription", "Diddy Kong Racing - Recompiled\0"
            VALUE "FileVersion", DKR_RELEASE_VERSION "\0"
            VALUE "InternalName", "DKR-R\0"
            VALUE "OriginalFilename", "DKR-R.exe\0"
            VALUE "ProductName", "DKR-R\0"
            VALUE "ProductVersion", DKR_RELEASE_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
