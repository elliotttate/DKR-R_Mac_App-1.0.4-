+// Integer reference-matched filter. Source/destination are separate resources.
+struct MipDimensions { uint2 source; uint2 target; };
+[[vk::push_constant]] ConstantBuffer<MipDimensions> dims : register(b0);
+Texture2D<float4> inputTexture : register(t1);
+RWTexture2D<float4> outputTexture : register(u2);
+[numthreads(8, 8, 1)]
+void CSMain(uint2 pos : SV_DispatchThreadID) {
+    if (any(pos >= dims.target)) return;
+    uint2 begin = pos * dims.source / dims.target;
+    uint2 end = (pos + 1) * dims.source / dims.target;
+    uint4 sums = 0; uint3 raw = 0; uint count = 0;
+    for (uint y = begin.y; y < end.y; ++y) for (uint x = begin.x; x < end.x; ++x) {
+        uint4 c = uint4(round(saturate(inputTexture.Load(int3(x, y, 0))) * 255.0));
+        sums.rgb += c.rgb * c.a; sums.a += c.a; raw += c.rgb; ++count;
+    }
+    uint3 rgb = sums.a ? (sums.rgb + sums.a / 2) / sums.a : (raw + count / 2) / count;
+    outputTexture[pos] = float4(rgb, (sums.a + count / 2) / count) / 255.0;
+}
